# ==============================================================================
# AIRGAP APPLIANCE - ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to `.env` before starting the containerized stack:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AIR-GAP & ZERO-TELEMETRY ENFORCEMENT
# ------------------------------------------------------------------------------
AIRGAP_MODE=strict
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
DO_NOT_TRACK=1
VLLM_NO_USAGE_STATS=1
NEXT_TELEMETRY_DISABLED=1
QDRANT__TELEMETRY_DISABLED=true

# ------------------------------------------------------------------------------
# 2. PORTABLE STORAGE & MODEL WEIGHT PATHS
# Point STORAGE_ROOT and MODELS_ROOT to external USB 3.2 Gen2 NVMe mount point
# (e.g., /mnt/airgap_usb/storage or E:/AirGap/storage) for portable demo mode.
# ------------------------------------------------------------------------------
STORAGE_ROOT=./storage
MODELS_ROOT=./models

# Local model directory names inside ${MODELS_ROOT}
LLM_MODEL_DIR=Qwen2.5-14B-Instruct-AWQ
EMBEDDING_MODEL_DIR=bge-large-en-v1.5
RERANKER_MODEL_DIR=bge-reranker-large
DOCLING_ARTIFACTS_DIR=docling

# ------------------------------------------------------------------------------
# 3. HARDWARE & RTX 4090 MOBILE (16GB VRAM) BUDGET ALLOCATION
# ------------------------------------------------------------------------------
# Target VRAM Breakdown:
# - Qwen 2.5 14B-Instruct (AWQ 4-bit): ~9.5 GB
# - KV Cache Headroom (8192 context):  ~2.5 GB
# - BAAI/bge-large-en-v1.5 (FP16):     ~1.5 GB
# - BAAI/bge-reranker-large (FP16):    ~1.2 GB
# Total Budget:                        ~14.7 GB / 16.0 GB
# ------------------------------------------------------------------------------
LLM_SERVED_MODEL_NAME=qwen2.5-14b-instruct
LLM_QUANTIZATION=awq
LLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.74
VLLM_API_KEY=airgap-local-token
EMBEDDING_DEVICE=cuda
RERANKER_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32
RERANKER_BATCH_SIZE=16

# ------------------------------------------------------------------------------
# 4. SERVICE PORTS (BOUND TO 127.0.0.1 LOOPBACK ONLY)
# ------------------------------------------------------------------------------
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
OPENSEARCH_PORT=9200
REDIS_PORT=6379
VLLM_PORT=8000
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# 5. HYBRID RETRIEVAL & RERANKING PARAMETERS
# ------------------------------------------------------------------------------
QDRANT_COLLECTION=technical_manuals
OPENSEARCH_INDEX=technical_manuals_bm25
OPENSEARCH_PASSWORD=AirGap#Admin2026!

# Stage 1: Parallel Dense + Sparse Candidate Retrieval
DENSE_TOP_K=30
SPARSE_TOP_K=30
RRF_K_CONSTANT=60

# Stage 2: Cross-Encoder Re-scoring
RERANK_TOP_K=5
RERANK_MIN_SCORE_THRESHOLD=-2.5

# ------------------------------------------------------------------------------
# 6. INGESTION & DOCUMENT SECURITY CLASSIFICATION
# ------------------------------------------------------------------------------
DEFAULT_SECURITY_CLASSIFICATION=CUI//NOFORN
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
OCR_ENABLED=true
EXTRACT_SCHEMATIC_CROPS=true
