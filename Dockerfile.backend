FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    DO_NOT_TRACK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# CIS Benchmark & N-09 Hardening: Create non-root dedicated application user
RUN groupadd -g 10001 appuser && \
    useradd -u 10001 -g appuser -d /app -s /usr/sbin/nologin appuser

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip3 install --no-cache-dir -r /app/requirements.txt

COPY services /app/services

# Ensure correct permissions for non-root execution
RUN chown -R appuser:appuser /app

USER 10001:10001

EXPOSE 8080

CMD ["uvicorn", "services.main:app", "--host", "0.0.0.0", "--port", "8080"]

